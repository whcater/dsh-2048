{
  "name": "@byteheng/dsh-2048",
  "version": "1.0.0",
  "type": "module",
  "description": "A tactile 2048 puzzle panel for the DeepSeek Harness sidebar.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "2048",
    "game"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whcater/dsh-2048.git"
  },
  "bugs": {
    "url": "https://github.com/whcater/dsh-2048/issues"
  },
  "homepage": "https://github.com/whcater/dsh-2048#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
